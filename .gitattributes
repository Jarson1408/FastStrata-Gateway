# Default: detect line endings automatically.
* text=auto

# Force LF for files used on Unix-like systems — CRLF would break them.
*.sh             text eol=lf
*.service        text eol=lf
*.plist          text eol=lf
Modelfile        text eol=lf
*.Modelfile      text eol=lf

# Force CRLF for Windows-only files.
*.bat            text eol=crlf
*.ps1            text eol=crlf

# Source files: use LF for portability.
*.py             text eol=lf
*.json           text eol=lf
*.md             text eol=lf
*.txt            text eol=lf
LICENSE          text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf
